# ==============================================================================
# PetFlow ERP - Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env caso prefira variáveis de ambiente clássicas
# em vez do arquivo .streamlit/secrets.toml. O PetFlow ERP aceita AMBOS!
# ==============================================================================

# 1. Conexão com o PostgreSQL no Supabase
# RECOMENDADO: Porta 6543 (Transaction Pooler - PgBouncer/Supavisor)
# Evita esgotamento do limite de conexões durante os reruns do Streamlit:
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Conexão direta (Porta 5432 - alternativa para migrações DDL pontuais):
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# 2. Configurações de Autenticação Google / Supabase Auth
# E-mail padrão caso acesse sem login ativo
DEFAULT_ADMIN_EMAIL=professor@ufape.edu.br

# Permitir fallback acadêmico para o avaliador da 1ª VA
# Defina 'true' para a apresentação; 'false' em produção estrita
ALLOW_EVALUATOR_FALLBACK=true

# 3. Chaves Opcionais da API do Supabase (caso utilize chamadas REST adicionais via Supabase SDK)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui
