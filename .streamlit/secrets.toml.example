# ==============================================================================
# PetFlow ERP - Configurações de Conexão (Supabase PostgreSQL & Google Auth)
# Copie este arquivo para .streamlit/secrets.toml e preencha com suas credenciais.
# ==============================================================================

[database]
# URL de conexão com o PostgreSQL no Supabase (Transaction Pooler ou Direct Connection)
# Exemplo: "postgresql://postgres.xxxx:sua_senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
url = "postgresql://postgres:sua_senha@db.xxxx.supabase.co:5432/postgres"

[auth]
# Configurações para Google Auth no Streamlit Community Cloud ou Supabase
enabled = true
default_admin_email = "admin@petflow.com"
