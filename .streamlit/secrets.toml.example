# ==============================================================================
# PetFlow ERP - Configurações de Conexão (Supabase PostgreSQL & Google Auth)
# Copie este arquivo para .streamlit/secrets.toml e preencha com suas credenciais.
# ==============================================================================

[database]
# RECOMENDADO: Transaction Pooler do Supabase (Porta 6543 - PgBouncer/Supavisor)
# Evita esgotamento de conexões no plano gratuito durante os reruns do Streamlit:
url = "postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Conexão direta (Porta 5432 - Apenas para migrações DDL pontuais):
# url = "postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"

[auth]
# Configurações para Google Auth no Streamlit Community Cloud ou Supabase Auth
enabled = true
default_admin_email = "professor@ufape.edu.br"

# Permitir modo de avaliação acadêmica (fallback) caso o e-mail não esteja em colaboradores
# Deixe 'true' para apresentação da 1ª VA; mude para 'false' em produção comercial estrita.
allow_evaluator_fallback = true
